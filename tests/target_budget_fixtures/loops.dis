ws_render:
 100: 00 00  r0 = 0
 102: 00 00  r0 += 1
 104: 00 00  if r0 < r1 goto -2 <ws_render: 102 >
 106: 00 00  ret
ws_run:
 200: 00 00  r0 = 0
 202: 00 00  r1 = 0
 204: 00 00  r1 += 1
 206: 00 00  if r1 < r2 goto -2 <ws_run: 204 >
 208: 00 00  if r0 < r3 goto -6 <ws_run: 202 >
 20a: 00 00  ret
ws_tap:
 300: 00 00  r0 = 0
 302: 00 00  r0 += 1
 304: 00 00  if r0 < r1 goto -2 <ws_tap: 302 >
 306: 00 00  r2 = 0
 308: 00 00  r2 += 1
 30a: 00 00  if r2 < r3 goto -2 <ws_tap: 308 >
 30c: 00 00  ret
ws_inc:
 400: 00 00  r0 = 0
 402: 00 00  r0 += 1
 404: 00 00  if r0 < r1 goto -2 <ws_inc: 402 >
 406: 00 00  r2 += 1
 408: 00 00  if r2 < r3 goto -6 <ws_inc: 402 >
 40a: 00 00  ret
click_render:
 500: 00 00  if r0 == 0 goto 6 <click_render: 506 >
 502: 00 00  r1 += 1
 504: 00 00  goto 6 <click_render: 50a >
 506: 00 00  r2 = 1
 508: 00 00  goto -6 <click_render: 502 >
 50a: 00 00  ret
perf_block:
 600: 00 00  r0 = 0
 602: 00 00  call <perf_flanger>
 604: 00 00  r0 += 1
 606: 00 00  if r0 < r1 goto -4 <perf_block: 602 >
 608: 00 00  ret
perf_flanger:
 700: 00 00  r0 = r1 / r2
 702: 00 00  r3 += 1
 704: 00 00  if r3 < r4 goto -4 <perf_flanger: 700 >
 706: 00 00  ret
perf_phaser:
 800: 00 00  r0 = r1 / r2
 802: 00 00  r3 = r4 / r5
 804: 00 00  r6 += 1
 806: 00 00  if r6 < r7 goto -4 <perf_phaser: 802 >
 808: 00 00  ret
rev_room:
 900: 00 00  r0 = 0
 902: 00 00  r0 += 1
 904: 00 00  if r0 < r1 goto -2 <rev_room: 902 >
 906: 00 00  ret
rev_hall:
 a00: 00 00  r0 = 0
 a02: 00 00  r1 = 0
 a04: 00 00  r2 = 0
 a06: 00 00  r3 = 0
 a08: 00 00  r4 = 0
 a0a: 00 00  r5 += 1
 a0c: 00 00  if r5 < r6 goto -2 <rev_hall: a0a >
 a0e: 00 00  if r4 < r6 goto -6 <rev_hall: a08 >
 a10: 00 00  if r3 < r6 goto -10 <rev_hall: a06 >
 a12: 00 00  if r2 < r6 goto -14 <rev_hall: a04 >
 a14: 00 00  if r1 < r6 goto -18 <rev_hall: a02 >
 a16: 00 00  ret
mod_begin:
 b00: 00 00  call <perf_flanger>
 b02: 00 00  r0 = r1 / r2
 b04: 00 00  ret
